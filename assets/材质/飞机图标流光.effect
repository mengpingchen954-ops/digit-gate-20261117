CCEffect %{
  techniques:
  - passes:
    - vert: plane-icon-vs:vert
      frag: plane-icon-fs:frag
      rasterizerState: { cullMode: none }
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        shineColor: { value: [0.65, 0.9, 1, 1], editor: { type: color, displayName: 流光颜色 } }
        shine: { value: [0.55, 0.13, 0.85, 0.35], editor: { displayName: 速度_宽度_强度_倾斜 } }
}%
CCProgram plane-icon-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return cc_matViewProj * pos;
  }
}%
CCProgram plane-icon-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  in vec2 uv0;
  in vec4 color;
  uniform PlaneShine { vec4 shineColor; vec4 shine; };
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  vec4 frag () {
    vec4 base = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0) * color;
    // 使用原图透明度裁切亮带，飞机外不会出现发亮方框。
    float center = fract(cc_time.x * shine.x) * 2.6 - 0.8;
    float distanceToBand = abs(uv0.x + (uv0.y - 0.5) * shine.w - center);
    float band = 1.0 - smoothstep(0.0, max(0.001, shine.y), distanceToBand);
    base.rgb = mix(base.rgb, shineColor.rgb, band * shine.z * shineColor.a);
    return base;
  }
}%
